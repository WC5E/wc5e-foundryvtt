{
  "name": "wc5e-foundryvtt",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the Warcraft 5e Manual of Monsters Foundry compendium.",
  "type": "module",
  "scripts": {
    "actors": "tsx build/convert-monster-json/main.ts",
    "items": "python3 build/build_items.py",
    "spells": "python3 build/extract_spells.py && python3 build/build_spells.py",
    "journal": "python3 build/build_journal.py",
    "pack": "node build/pack.mjs",
    "release": "node build/release.mjs",
    "build": "npm run spells && npm run actors && npm run items && npm run journal && npm run spell-lists && npm run subclass-spells && npm run backgrounds && npm run spell-progression && npm run sources && npm run pack",
    "spell-lists": "python3 build/build_spell_lists.py",
    "backgrounds": "python3 build/build_backgrounds.py",
    "sources": "node build/register-sources.mjs",
    "spell-progression": "python3 build/build_spell_progression.py",
    "subclass-spells": "python3 build/build_subclass_spells.py",
    "pdfs": "python3 build/extract_pdfs.py",
    "verify": "python3 build/verify.py",
    "check-packs": "node build/check_packs.mjs",
    "lint": "eslint .",
    "test": "npm run test-python && npm run test-vite",
    "test-python": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test-vite": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^1.0.4",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
