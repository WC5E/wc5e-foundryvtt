    {
      "_id": "dW3NBUMqSnZSXhmj",
      "name": "Frost Form",
      "type": "feat",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": {
          "value": "<p>The elemental can burrow through nonmagical unworked ice and snow. While doing so, the elemental doesn't disturb the material it moves through. A creature that touches the elemental or hits it with a melee attack while within 5 feet of it takes 3 ([[/damage 1d6 cold]]). Additionally, the elemental freezes non-creature liquids within a 10-foot radius of it. A creature caught in the liquid when the elemental freezes it is grappled (escape DC 13).</p>",
          "chat": ""
        },
