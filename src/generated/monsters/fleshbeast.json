    {
      "_id": "1NE3vAXFGWsGclgd",
      "name": "Tentacle",
      "type": "feat",
      "img": "icons/svg/sword.svg",
      "system": {
        "description": {
          "value": "<p><em>Melee Weapon Attack:</em> +4 to hit, reach 5 ft., one creature. <em>Hit:</em>9 ([[/damage 2d6 + 2 bludgeoning]]), and if the target is Small or larger, the fleshbeast attaches to it, moving into its space which is shared with the target. The fleshbeast's movement speed becomes 0 and it gains advantage on bite attacks against the target. In addition, at the start of each of the target's turns, the target takes 7 ([[/damage 2d6 acid]]) and if the target moves the fleshbeast moves with it. The fleshbeast can detach itself as a bonus action, in which case it regains its movement speed and needs to spend that movement speed to move out of the target's space. A creature, including the target, can take its action to detach the fleshbeast by succeeding on a DC 14 Strength check.</p>",
          "chat": ""
        },
