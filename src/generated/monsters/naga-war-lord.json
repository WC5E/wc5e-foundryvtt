    {
      "_id": "d2e9rHKFSMEZQHQm",
      "name": "Crashing Wave (Recharges 5-6)",
      "type": "feat",
      "img": "icons/svg/sword.svg",
      "system": {
        "description": {
          "value": "<p>The naga charges forward creating a wave of water that crashes anyone on its path. The naga moves 20 feet forward in a straight line producing a wave 20 feet long, 10 feet tall and 10 feet wide . Each creature in that area must make a Dexterity saving throw. On a failed save, a creature takes 22 ([[/damage 5d8 bludgeoning]]) and is knocked prone. On a successful save, a creature takes half as much damage and isn't knocked prone.</p>",
          "chat": ""
        },
        "identifier": "",
        "source": {
          "custom": "",
          "book": "",
          "page": "",
          "license": "",
          "revision": 1,
          "rules": "2014"
        },
        "activation": {
          "type": "",
